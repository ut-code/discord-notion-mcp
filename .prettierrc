{
  "printWidth": 140,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "plugins": ["prettier-plugin-svelte", "prettier-plugin-tailwindcss"],
  "tailwindStylesheet": "./src/app.css",
  "overrides": [
    { "files": "*.svelte", "options": { "parser": "svelte" } },
    { "files": ["src/lib/components/ui/**", "src/app.css", "components.json"], "options": { "useTabs": true } }
  ]
}
