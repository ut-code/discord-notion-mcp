{
  "name": "discord-notion-mcp",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "prepare": "bun scripts/compile-messages.ts && (bun --bun svelte-kit sync || echo ''; lefthook install || echo '')",
    "dev": "bun --bun vite dev",
    "build": "bun --bun vite build",
    "start": "NODE_ENV=production BODY_SIZE_LIMIT=4M bun build/index.js",
    "preview": "PREVIEW=1 PORT=3920 bun --bun vite dev",
    "test": "bun test",
    "typecheck": "bun scripts/compile-messages.ts && bun --bun svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
    "lint": "SVELTE_ESLINT_PARSER_EXPERIMENTAL_TS_SYS_HOOK=1 eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@better-auth/cimd": "^1.7.7",
    "@better-auth/mcp": "^1.7.7",
    "@discordjs/rest": "^2.6.3",
    "@modelcontextprotocol/server": "^2.3.1",
    "@notionhq/client": "^5.27.0",
    "@sapphire/snowflake": "^3.5.5",
    "better-auth": "^1.7.7",
    "diff": "^9.0.0",
    "discord-api-types": "^0.38.56",
    "drizzle-orm": "^0.45.4",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "^2.27.0",
    "@inlang/plugin-message-format": "4.5.3",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.55.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "bits-ui": "^2.19.5",
    "cn": "^0.3.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "knip": "^6.42.0",
    "lefthook": "^2.2.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn-svelte": "^1.7.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "1.9.0",
    "svelte-sonner": "^1.2.1",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  }
}
