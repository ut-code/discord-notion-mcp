{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Paraglide loads it from the project directory by name.
  "entry": ["project.inlang/paraglide.config.ts"],
  // Generated by shadcn-svelte, which exports every part.
  "ignoreIssues": { "src/lib/components/ui/**": ["exports", "types"], "src/lib/utils.ts": ["types"] },
  "ignoreDependencies": [
    // Loaded by path from project.inlang/settings.json.
    "@inlang/plugin-message-format",
    // svelte-check --tsgo.
    "@typescript/native",
    // Parser of eslint-plugin-svelte, configured by SVELTE_ESLINT_PARSER_* in the lint script.
    "svelte-eslint-parser",
  ],
}
