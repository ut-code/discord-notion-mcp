# Public origin of this server (no path). http is allowed only for localhost.
PUBLIC_URL=https://mcp.example.com
PORT=3000
# SQLite file; the Docker image defaults to /data/app.db (mount a volume at /data).
DATABASE_PATH=./data/app.db
# Reverse proxies in front of the server that append to X-Forwarded-For (default 1 = Coolify/Traefik).
# Use 2 behind e.g. Cloudflare -> Traefik, 0 when clients connect directly. Used for sign-in rate limiting.
TRUSTED_PROXY_COUNT=1

# At least 32 characters: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Discord application (OAuth2). Add this redirect URL in the Developer Portal:
#   ${PUBLIC_URL}/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Bot token of the same (or another) application; the bot must be in the guild.
# Enable the privileged "Message Content Intent" (without it REST returns empty message
# content) and "Server Members Intent" (member search). No gateway connection is used. The bot needs
# View Channel + Read Message History on every channel readable through the MCP tools.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Optional. Without it the Notion tools are not registered.
# Create an internal integration (https://www.notion.so/profile/integrations) with the
# capabilities: Read content, Update content, Insert content, Read comments, Insert comments,
# and the user capability "User information without email addresses".
# Then connect it to the top-level pages to expose ("..." menu > Connections); child pages inherit access.
# All edits appear as this integration in Notion; attribution and revert are kept in this server's audit log.
NOTION_TOKEN=
