{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "ESNext",
    "types": ["$app/types", "bun"],
    // svelte-check --tsgo loses the types of .svelte files imported through package.json imports.
    "paths": { "#lib/*": ["./src/lib/*"], "$app/types": ["./.svelte-kit/types/index.d.ts"] },
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  "include": ["src", "vite.config.ts", "drizzle.config.ts", "test"]
}
